<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appointmentsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_space_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@android:color/transparent">

        <ImageButton
            android:id="@+id/btnBackAppointments"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/textColorPrimary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Appointments"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dividerColor" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFilterCalendars"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Calendars"
            android:textAllCaps="false"
            android:textColor="@color/textColorPrimary"
            android:textSize="14sp"
            android:background="@drawable/bg_neon_cyan_button"
            android:stateListAnimator="@null"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpenGoogleCalendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.45"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Open Google Calendar"
            android:textAllCaps="false"
            android:textColor="@color/textColorPrimary"
            android:textSize="14sp"
            android:maxLines="2"
            android:gravity="center"
            android:background="@drawable/bg_neon_cyan_button"
            android:stateListAnimator="@null"
            app:backgroundTint="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/btnPrevMonth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="28sp"
            android:textColor="@color/colorInfo"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous month" />

        <TextView
            android:id="@+id/tvMonthLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="This month" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnJumpToday"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="72dp"
            android:minHeight="36dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Today"
            android:textAllCaps="false"
            android:textColor="@color/textColorPrimary"
            android:textSize="13sp"
            android:background="@drawable/bg_neon_cyan_button"
            android:stateListAnimator="@null"
            app:backgroundTint="@null"
            android:contentDescription="Jump to today" />

        <TextView
            android:id="@+id/btnNextMonth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="›"
            android:textSize="28sp"
            android:textColor="@color/colorInfo"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next month" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnFilterUpcoming"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Upcoming &amp; Today"
            android:textColor="@color/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:background="@drawable/bg_neon_cyan_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnFilterAllMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="All Month (Include Past)"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:background="@drawable/bg_frosted_pill_input"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnFilterAllEvents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="All Events"
            android:textColor="@color/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:background="@drawable/bg_neon_cyan_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Show all events" />

        <TextView
            android:id="@+id/btnFilterCrmOnly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="CRM Only"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:background="@drawable/bg_frosted_pill_input"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Show RCRM appointments only" />

        <TextView
            android:id="@+id/btnToggleOpenSlots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="⚡ Show Open Slots"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:background="@drawable/bg_frosted_pill_input"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Show open time slots between events" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDayStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/rowSelectedDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedDayLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorInfo"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnShowFullMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_frosted_pill_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Show Full Month"
            android:textColor="@color/textColorPrimary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCalendarStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:background="@drawable/bg_frosted_card"
        android:text="Calendar access is off. Tap to show Google Calendar events."
        android:textColor="@color/colorInfo"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSyncStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:background="@drawable/bg_frosted_card"
        android:textColor="@color/colorDanger"
        android:textSize="13sp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppointments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvNoAppointments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="88dp"
            android:padding="24dp"
            android:gravity="center"
            android:text="No appointments or calendar events this month"
            android:textColor="@color/textColorSecondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressAppointments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary" />

        <LinearLayout
            android:id="@+id/appointmentActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@color/backgroundColor"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:elevation="6dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dividerColor" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNewAppointment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:minHeight="52dp"
                android:minWidth="48dp"
                android:text="+ New Appointment"
                android:textAllCaps="false"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:maxLines="2"
                android:background="@drawable/bg_neon_cyan_button"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"
                android:contentDescription="New appointment" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
