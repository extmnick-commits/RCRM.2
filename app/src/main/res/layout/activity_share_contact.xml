<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shareContactRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_space_gradient"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Share to RCRM"
            android:textColor="#F4F7FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnShareCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#9AA6BD" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cardShareStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_frosted_card"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvShareStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#F4F7FF"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnShareDone"
                    style="@style/SmartLogPrimaryButton"
                    android:layout_marginTop="14dp"
                    android:text="Done" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerShareReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_frosted_card"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contact name"
                        android:textColor="#9AA6BD"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etShareContactName"
                        style="@style/SmartLogInput"
                        android:hint="Enter contact name"
                        android:inputType="textCapWords|textPersonName" />

                    <TextView
                        android:id="@+id/tvShareMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#9AA6BD"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_frosted_card"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone numbers"
                        android:textColor="#F4F7FF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSharePhoneHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Choose the main number to open in Smart Log. All shared numbers will be saved."
                        android:textColor="#9AA6BD"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/layoutSharePhones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnShareSaveDirect"
                    style="@style/SmartLogButton"
                    android:layout_marginTop="14dp"
                    android:text="Save Contact to RCRM" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
