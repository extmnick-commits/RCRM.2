<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/bg_space_gradient">

    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/textColorPrimary" />

        <TextView
            android:id="@+id/tvSuperAdminTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Super Admin Management Panel"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:layout_toEndOf="@id/btnBack"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <Button
        android:id="@+id/btnMyAdminDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View My Team (Admin Dashboard)"
        android:layout_below="@id/headerContainer"
        android:layout_marginBottom="8dp"
        android:textAllCaps="false"
        android:textColor="@color/textColorPrimary"
        android:background="@drawable/bg_neon_cyan_button"
        app:backgroundTint="@null" />

    <ListView
        android:id="@+id/listViewAllUsers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnMyAdminDashboard"
        android:divider="@color/dividerColor"
        android:dividerHeight="1dp" />

</RelativeLayout>