<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_space_glass"
    android:fillViewport="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvEventActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvEventActionWhen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEventActionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_frosted_pill_input"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/colorInfo"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvEventActionDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowQuickReach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSendConfirmationText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="💬 Text"
                android:textAllCaps="false"
                android:textColor="@color/textColorPrimary"
                android:textSize="13sp"
                android:maxLines="2"
                android:gravity="center"
                android:background="@drawable/bg_neon_green_button"
                android:stateListAnimator="@null"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCallLead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="📞 Call"
                android:textAllCaps="false"
                android:textColor="@color/textColorPrimary"
                android:textSize="13sp"
                android:maxLines="2"
                android:gravity="center"
                android:background="@drawable/bg_neon_cyan_button"
                android:stateListAnimator="@null"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMapOrLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="📍 Map/Link"
                android:textAllCaps="false"
                android:textColor="@color/textColorPrimary"
                android:textSize="13sp"
                android:maxLines="2"
                android:gravity="center"
                android:background="@drawable/bg_neon_purple_button"
                android:stateListAnimator="@null"
                app:backgroundTint="@null" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogOutcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:minHeight="52dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="✅ Log Outcome (Completed / Reschedule / No-Show)"
            android:textAllCaps="false"
            android:textColor="@color/backgroundColor"
            android:textSize="14sp"
            android:maxLines="2"
            android:gravity="center"
            android:background="@drawable/bg_primary_gradient_button"
            android:stateListAnimator="@null"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewInGoogleCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="View / Edit in Google Calendar"
            android:textAllCaps="false"
            android:textColor="@color/textColorPrimary"
            android:textSize="15sp"
            android:background="@drawable/bg_neon_cyan_button"
            android:stateListAnimator="@null"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpenLeadInRcrm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="Open Lead in RCRM"
            android:textAllCaps="false"
            android:textColor="@color/textColorPrimary"
            android:textSize="15sp"
            android:background="@drawable/bg_neon_purple_button"
            android:stateListAnimator="@null"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveOrLinkLead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="52dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="+ Save as New RCRM Lead / Link to Contact"
            android:textAllCaps="false"
            android:textColor="@color/textColorPrimary"
            android:textSize="15sp"
            android:maxLines="2"
            android:gravity="center"
            android:background="@drawable/bg_neon_green_button"
            android:stateListAnimator="@null"
            android:visibility="gone"
            app:backgroundTint="@null" />

        <LinearLayout
            android:id="@+id/outcomeActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Appointment status"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOutcomeCompleted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="Completed"
                android:textAllCaps="false"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:background="@drawable/bg_neon_green_button"
                android:stateListAnimator="@null"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOutcomeNoShow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="No-show"
                android:textAllCaps="false"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:background="@drawable/bg_neon_purple_button"
                android:stateListAnimator="@null"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOutcomeCanceled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="Canceled"
                android:textAllCaps="false"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:background="@drawable/bg_frosted_pill_input"
                android:stateListAnimator="@null"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOutcomeReschedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="Reschedule"
                android:textAllCaps="false"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:background="@drawable/bg_neon_cyan_button"
                android:stateListAnimator="@null"
                app:backgroundTint="@null" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnQuickNoteFollowUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="+ Quick Note / Set Follow-Up"
            android:textAllCaps="false"
            android:textColor="@color/textColorPrimary"
            android:textSize="15sp"
            android:background="@drawable/bg_neon_purple_button"
            android:stateListAnimator="@null"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCloseEventActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/textColorSecondary"
            android:background="@android:color/transparent"
            app:backgroundTint="@null" />
    </LinearLayout>
</ScrollView>
