<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_space_glass"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvQuickNoteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Quick Note / Set Follow-Up"
        android:textColor="@color/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQuickNoteEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:textColor="@color/textColorSecondary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/rowOutcomeChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/chipOutcomeCompleted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_frosted_pill_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="Completed ✅"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipOutcomeRescheduled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_frosted_pill_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="Rescheduled 📅"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipOutcomeNoShow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_frosted_pill_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="No-Show ⚠️"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/etQuickNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_frosted_pill_input"
        android:gravity="top|start"
        android:hint="Post-appointment note"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="3"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/textColorSecondary"
        android:textSize="15sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSetFollowUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_frosted_pill_input"
        android:minHeight="44dp"
        android:stateListAnimator="@null"
        android:text="Set Follow-Up"
        android:textAllCaps="false"
        android:textColor="@color/textColorPrimary"
        android:textSize="14sp"
        app:backgroundTint="@null" />

    <TextView
        android:id="@+id/tvFollowUpSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="No follow-up change"
        android:textColor="@color/colorInfo"
        android:textSize="13sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveQuickNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_neon_green_button"
        android:minHeight="48dp"
        android:stateListAnimator="@null"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="@color/textColorPrimary"
        android:textSize="15sp"
        app:backgroundTint="@null" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancelQuickNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/textColorSecondary"
        app:backgroundTint="@null" />

</LinearLayout>
