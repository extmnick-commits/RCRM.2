<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_space_glass"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Save as New RCRM Lead"
        android:textColor="@color/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSaveLeadSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:text="Name is filled from the calendar event. Save it as a lead, or link it to a contact you already have."
        android:textColor="@color/textColorSecondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSaveLeadName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_frosted_pill_input"
        android:hint="Lead name"
        android:inputType="textPersonName|textCapWords"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/textColorSecondary"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etSaveLeadPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_frosted_pill_input"
        android:hint="Phone (optional)"
        android:inputType="phone"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="@color/textColorPrimary"
        android:textColorHint="@color/textColorSecondary"
        android:textSize="15sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPickDeviceContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_frosted_pill_input"
        android:minHeight="48dp"
        android:stateListAnimator="@null"
        android:text="Pick Device Contact"
        android:textAllCaps="false"
        android:textColor="@color/textColorPrimary"
        android:textSize="14sp"
        app:backgroundTint="@null" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveNewLead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neon_green_button"
        android:minHeight="48dp"
        android:stateListAnimator="@null"
        android:text="Save as New Lead"
        android:textAllCaps="false"
        android:textColor="@color/textColorPrimary"
        android:textSize="15sp"
        app:backgroundTint="@null" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLinkExistingLead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neon_purple_button"
        android:minHeight="48dp"
        android:stateListAnimator="@null"
        android:text="Link to Existing Lead"
        android:textAllCaps="false"
        android:textColor="@color/textColorPrimary"
        android:textSize="15sp"
        app:backgroundTint="@null" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancelSaveLead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/textColorSecondary"
        app:backgroundTint="@null" />

</LinearLayout>
