<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvNoteDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neon_cyan_button"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="#2EE7FF"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Oct 27, 2026 5:09 PM" />

    <TextView
        android:id="@+id/tvNoteContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="#E0E6F5"
        android:textSize="14sp"
        tools:text="Discussed next steps." />
</LinearLayout>
