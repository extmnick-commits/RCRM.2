<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/surfaceGlass"
    app:strokeColor="@color/dividerColor"
    app:strokeWidth="1dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Complete Button (Checkbox) -->
        <ImageButton
            android:id="@+id/btnCompleteReminder"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/checkbox_off_background"
            app:tint="@color/colorInfo"
            android:contentDescription="Complete Reminder" />

        <!-- Type Icon -->
        <ImageView
            android:id="@+id/ivReminderTypeIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:src="@android:drawable/ic_menu_call"
            app:tint="@color/colorSuccess"
            android:background="@drawable/bg_icon_circle_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReminderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reminder Title"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReminderDue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tomorrow 9:00 AM"
                android:textColor="@color/colorInfo"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReminderNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/textColorSecondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutReminderActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLaunchAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Call"
                    android:textAllCaps="false"
                    android:textColor="@color/colorInfo"
                    android:textSize="14sp"
                    android:background="@drawable/bg_neon_cyan_button"
                    app:backgroundTint="@null"
                    app:iconTint="@color/colorInfo"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemindLater"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:text="Later"
                    android:textAllCaps="false"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Overflow Menu -->
        <ImageButton
            android:id="@+id/btnReminderOverflow"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/textColorSecondary"
            android:contentDescription="Options" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
