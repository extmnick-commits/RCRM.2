<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#B14CFF"
    app:cardBackgroundColor="#1E1433">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSideKickLeadName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lead Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"/>

        <TextView
            android:id="@+id/tvSideKickSuggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is the AI's suggestion for what to do next with this lead."
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"/>

        <TextView
            android:id="@+id/tvSideKickCoachedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suggested 5 minutes ago"
            android:layout_marginTop="12dp"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="?android:attr/textColorTertiary"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>