<?xml version='1.0' encoding='UTF-8'?>
<resources>
    <style name="SmartLogCard">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item><item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">12dp</item><item name="android:background">@drawable/bg_frosted_card</item>
    </style>
    <style name="SmartLogBody">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item><item name="android:textColor">#FF9AA6BD</item>
        <item name="android:paddingVertical">4dp</item>
    </style>
    <style name="SmartLogLabel" parent="SmartLogBody">
        <item name="android:textSize">15sp</item><item name="android:textColor">#FFF4F7FF</item><item name="android:textStyle">bold</item>
    </style>
    <style name="SmartLogTitle" parent="SmartLogLabel"><item name="android:textSize">24sp</item></style>
    <style name="SmartLogInput">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item><item name="android:padding">12dp</item><item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_edittext_outline</item><item name="android:textColor">#FFF4F7FF</item>
        <item name="android:textColorHint">#FF9AA6BD</item><item name="android:textSize">16sp</item><item name="android:importantForAutofill">no</item>
    </style>
    <style name="SmartLogButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item><item name="android:minWidth">0dp</item><item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item><item name="android:layout_marginTop">6dp</item>
        <item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item><item name="android:textColor">#2EE7FF</item>
        <item name="android:background">@drawable/bg_neon_cyan_button</item><item name="backgroundTint">@null</item>
    </style>
    <style name="SmartLogPrimaryButton" parent="SmartLogButton">
        <item name="android:minHeight">54dp</item><item name="android:textColor">#FFFFFF</item><item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item><item name="android:background">@drawable/bg_primary_gradient_button</item>
    </style>
    <style name="SmartLogDisclosure">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">36dp</item><item name="android:orientation">horizontal</item><item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item><item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
    <style name="SmartLogDisclosureCard">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item><item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">8dp</item><item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_frosted_card</item>
    </style>
    <style name="SmartLogChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFF4F7FF</item><item name="chipBackgroundColor">@color/smart_log_chip_fill</item>
        <item name="chipStrokeColor">@color/smart_log_chip_stroke</item><item name="chipStrokeWidth">1dp</item>
        <item name="ensureMinTouchTargetSize">true</item><item name="chipMinTouchTargetSize">48dp</item>
    </style>
