ignore">Stop showing logs for this number</string><string name="sl_save_hint">Save adds this log and any new next steps to the contact.</string><string name="sl_save">Save log</string><string name="sl_saving">Saving…</string><string name="sl_saved">Call log saved</string><string name="sl_reminder_due">New follow-up: %1$s</string><string name="sl_appointment_due">New appointment: %1$s</string><string name="sl_unknown_phone">No phone number provided</string><string name="sl_save_error">Could not save. Your entries are still here. Check your connection and try again.</string><string name="sl_name_required">Enter a contact name.</string><string name="sl_past_date">Choose a time in the future.</string><string name="sl_reminder_title_required">Add a reminder title.</string><string name="sl_discard_title">Discard this call log?</string><string name="sl_discard_message">Your unsaved note and next steps will be discarded.</string><string name="sl_discard">Discard</string><string name="sl_keep_editing">Keep editing</string><string name="sl_ignore_title">Stop call logs for this number?</string><string name="sl_ignore_message">You can turn logs back on in Settings &amp; Tools → Ignored contacts.</string><string name="sl_ignore_confirm">Stop logs</string><string name="sl_existing_contact">Existing RCRM contact · saved details are preserved</string><string name="sl_new_contact">New RCRM contact</string><string name="sl_open_text_error">Log saved. No texting app is available.</string><string name="sl_dictation_unavailable">Speech recognition is not available on this device.</string><string name="sl_default_action">Follow up</string><string name="sl_nothing_to_log">Choose an outcome, add a note, or select a next step.</string><string name="sl_partial_save">Contact details were saved. Finish saving this log: %1$s</string>
<string name="sl_appointment_saved">Appointment saved: %1$s</string>
</resources>
