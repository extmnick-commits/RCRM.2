<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SettingsSectionHeader">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/textColorSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="SettingsGroupedCard">
        <item name="android:layout_marginBottom">8dp</item>
        <item name="cardBackgroundColor">@color/surfaceGlass</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/dividerColor</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
